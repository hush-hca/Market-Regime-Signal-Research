FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    REGIME_RAW_DIR=/tmp/regime-atlas/raw

WORKDIR /app
COPY requirements-lock.txt ./requirements-lock.txt
RUN pip install --no-cache-dir -r requirements-lock.txt

COPY app.py ./app.py
COPY regime/ ./regime/
COPY .streamlit/config.toml ./.streamlit/config.toml

EXPOSE 80
CMD ["sh", "-c", "exec python -m streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true --browser.gatherUsageStats=false --server.maxUploadSize=4"]
