FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    REGIME_RAW_DIR=/tmp/regime-atlas/raw

WORKDIR /app
COPY requirements-lock.txt ./requirements-lock.txt
RUN pip install --no-cache-dir -r requirements-lock.txt

COPY app.py ./app.py
COPY regime/ ./regime/
COPY bootstrap/ ./bootstrap/
COPY .streamlit/config.toml ./.streamlit/config.toml

# Fail the deployment build if its offline real-data fallback is absent or corrupt.
RUN python -c "from regime.feed import BUNDLED_SNAPSHOT, read_snapshot; frame, meta = read_snapshot(BUNDLED_SNAPSHOT, require_digest=True); print('Verified bundled real market data:', meta['source'], len(frame), frame.date.max())"

EXPOSE 80
CMD ["sh", "-c", "exec python -m streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true --browser.gatherUsageStats=false --server.maxUploadSize=4"]
